#!/usr/bin/env python3
"""Fetch and display all review activity on a GitHub pull request.

Uses the gh CLI for GitHub API access (both GraphQL and REST).
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from datetime import date, datetime
from fnmatch import fnmatch
from typing import Any

# ---------------------------------------------------------------------------
# GitHub API helpers
# ---------------------------------------------------------------------------

def run_gh(*args: str) -> str:
    """Run a gh CLI command and return stdout."""
    try:
        result = subprocess.run(
            ["gh", *args],
            capture_output=True, text=True, check=True,
        )
        return result.stdout
    except FileNotFoundError:
        print("Error: gh (GitHub CLI) is not installed.", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(f"Error running gh {' '.join(args[:3])}...: {e.stderr.strip()}", file=sys.stderr)
        sys.exit(1)


def graphql(query: str, **variables: Any) -> dict:
    """Execute a GraphQL query via gh api graphql."""
    cmd = ["api", "graphql", "-f", f"query={query}"]
    for k, v in variables.items():
        if isinstance(v, int):
            cmd.extend(["-F", f"{k}={v}"])
        else:
            cmd.extend(["-f", f"{k}={v}"])
    raw = run_gh(*cmd)
    data = json.loads(raw)
    if "errors" in data:
        print(f"GraphQL errors: {data['errors']}", file=sys.stderr)
        sys.exit(1)
    return data.get("data", {})


# ---------------------------------------------------------------------------
# URL parsing
# ---------------------------------------------------------------------------

PR_URL_RE = re.compile(
    r"https?://github\.com/(?P<owner>[^/]+)/(?P<repo>[^/]+)/pull/(?P<number>\d+)"
)


def parse_pr_ref(pr_ref: str, repo_flag: str | None) -> tuple[str, str, int]:
    """Parse a PR reference into (owner, repo, number)."""
    m = PR_URL_RE.match(pr_ref)
    if m:
        return m.group("owner"), m.group("repo"), int(m.group("number"))

    # Try as a plain number with --repo
    try:
        number = int(pr_ref)
    except ValueError:
        print(f"Error: cannot parse PR reference '{pr_ref}'", file=sys.stderr)
        print("Use a URL like https://github.com/owner/repo/pull/123", file=sys.stderr)
        print("Or a number with --repo owner/repo", file=sys.stderr)
        sys.exit(1)

    if not repo_flag:
        print("Error: --repo is required when using a PR number", file=sys.stderr)
        sys.exit(1)

    parts = repo_flag.split("/")
    if len(parts) != 2:
        print(f"Error: --repo should be owner/repo, got '{repo_flag}'", file=sys.stderr)
        sys.exit(1)

    return parts[0], parts[1], number


# ---------------------------------------------------------------------------
# Data fetching
# ---------------------------------------------------------------------------

REVIEW_THREADS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      title
      url
      author { login }
      reviewThreads(first: 100, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          isResolved
          isOutdated
          path
          line
          startLine
          diffSide
          comments(first: 100) {
            nodes {
              id
              databaseId
              url
              author { login __typename }
              body
              createdAt
              diffHunk
            }
          }
        }
      }
    }
  }
}
"""

# GitHub splits a review into two parts. The review carries the state and the
# summary body; the inline notes hang off reviewThreads. Fetch both, or a
# reviewer who writes "looks good, two nits below" leaves no visible trace.
REVIEWS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviews(first: 50, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          author { login __typename }
          state
          body
          createdAt
          url
        }
      }
    }
  }
}
"""


def actor_is_bot(actor: dict | None) -> bool:
    """Report whether a GraphQL actor is a bot.

    GraphQL types the actor, so trust `__typename`. The login is not a reliable
    signal; `copilot-pull-request-reviewer` carries no `[bot]` suffix.
    """
    return (actor or {}).get("__typename") == "Bot"


def fetch_review_threads(owner: str, repo: str, number: int) -> tuple[dict, list[dict]]:
    """Fetch PR metadata and all review threads. Returns (pr_info, threads)."""
    threads = []
    cursor = None
    pr_info = {}

    while True:
        variables: dict[str, Any] = {"owner": owner, "repo": repo, "number": number}
        if cursor:
            variables["cursor"] = cursor

        data = graphql(REVIEW_THREADS_QUERY, **variables)
        pr = data.get("repository", {}).get("pullRequest", {})

        if not pr_info:
            pr_info = {
                "number": number,
                "title": pr.get("title", ""),
                "url": pr.get("url", ""),
                "author": (pr.get("author") or {}).get("login", "unknown"),
            }

        rt = pr.get("reviewThreads", {})
        for node in rt.get("nodes", []):
            comment_nodes = node.get("comments", {}).get("nodes", [])
            comments = []
            for c in comment_nodes:
                comments.append({
                    "id": c.get("id", ""),
                    "database_id": c.get("databaseId"),
                    "url": c.get("url", ""),
                    "author": (c.get("author") or {}).get("login", "unknown"),
                    "is_bot": actor_is_bot(c.get("author")),
                    "body": c.get("body", ""),
                    "created_at": c.get("createdAt", ""),
                })
            threads.append({
                "id": node.get("id", ""),
                "file": node.get("path", ""),
                "line": node.get("line"),
                "start_line": node.get("startLine"),
                "diff_side": node.get("diffSide", ""),
                # Every comment on a thread repeats the same anchor hunk.
                # Keep one copy.
                "diff_hunk": comment_nodes[0].get("diffHunk", "") if comment_nodes else "",
                "is_resolved": node.get("isResolved", False),
                "is_outdated": node.get("isOutdated", False),
                "comments": comments,
            })

        page_info = rt.get("pageInfo", {})
        if page_info.get("hasNextPage"):
            cursor = page_info.get("endCursor")
        else:
            break

    return pr_info, threads


def fetch_reviews(owner: str, repo: str, number: int) -> list[dict]:
    """Fetch every review on the PR, with its state and summary body."""
    reviews = []
    cursor = None

    while True:
        variables: dict[str, Any] = {"owner": owner, "repo": repo, "number": number}
        if cursor:
            variables["cursor"] = cursor

        data = graphql(REVIEWS_QUERY, **variables)
        node = data.get("repository", {}).get("pullRequest", {}).get("reviews", {})

        for r in node.get("nodes", []):
            reviews.append({
                "id": r.get("id", ""),
                "url": r.get("url", ""),
                "author": (r.get("author") or {}).get("login", "unknown"),
                "is_bot": actor_is_bot(r.get("author")),
                "state": r.get("state", ""),
                "body": r.get("body", ""),
                "created_at": r.get("createdAt", ""),
            })

        page_info = node.get("pageInfo", {})
        if page_info.get("hasNextPage"):
            cursor = page_info.get("endCursor")
        else:
            break

    return reviews


def fetch_issue_comments(owner: str, repo: str, number: int) -> list[dict]:
    """Fetch top-level PR comments (issue comments)."""
    # --slurp collects the pages into one JSON array of arrays. It cannot be
    # combined with -q. Parsing the whole payload at once beats reading it line
    # by line; gh is free to reformat its output, and a line-wise reader turns
    # that into a silent empty result.
    raw = run_gh("api", f"repos/{owner}/{repo}/issues/{number}/comments",
                 "--paginate", "--slurp")
    if not raw.strip():
        return []

    try:
        pages = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"Error: cannot parse issue comments from gh: {e}", file=sys.stderr)
        sys.exit(1)

    comments = []
    for page in pages:
        for c in page:
            user = c.get("user") or {}
            comments.append({
                "id": c.get("node_id", ""),
                "database_id": c.get("id"),
                "url": c.get("html_url", ""),
                "author": user.get("login", "unknown"),
                "is_bot": user.get("type") == "Bot",
                "body": c.get("body", ""),
                "created_at": c.get("created_at", ""),
            })

    return comments


# ---------------------------------------------------------------------------
# Filtering
# ---------------------------------------------------------------------------

def parse_datetime(s: str) -> datetime:
    """Parse ISO datetime string."""
    return datetime.fromisoformat(s.replace("Z", "+00:00"))


GLOB_CHARS = set("*?[")


def path_matches(path: str, patterns: list[str]) -> bool:
    """Test a file path against the --path patterns.

    A pattern holding glob characters matches as a glob. A plain pattern
    matches as a directory or filename prefix, so `--path src/api` picks up
    everything beneath it.
    """
    if not patterns:
        return True
    for pattern in patterns:
        if GLOB_CHARS & set(pattern):
            if fnmatch(path, pattern):
                return True
        elif path == pattern or path.startswith(pattern.rstrip("/") + "/"):
            return True
    return False


def latest_date(items: list[dict]) -> date | None:
    """Return the newest parseable creation date, or None if there is none."""
    dates = []
    for item in items:
        try:
            dates.append(parse_datetime(item["created_at"]).date())
        except (ValueError, TypeError):
            pass
    return max(dates) if dates else None


def filter_threads(
    threads: list[dict],
    unresolved_only: bool = False,
    by_user: str | None = None,
    since_date: date | None = None,
    no_bots: bool = False,
    paths: list[str] | None = None,
) -> list[dict]:
    filtered = []
    for thread in threads:
        if unresolved_only and thread["is_resolved"]:
            continue

        if not path_matches(thread["file"], paths or []):
            continue

        # Drop a thread only when every comment on it comes from a bot. A human
        # replying to a bot makes the whole exchange worth reading.
        if no_bots and all(c["is_bot"] for c in thread["comments"]):
            continue

        if by_user:
            authors = {c["author"].lower() for c in thread["comments"]}
            if by_user.lower() not in authors:
                continue

        if since_date:
            newest = latest_date(thread["comments"])
            if newest and newest < since_date:
                continue

        filtered.append(thread)
    return filtered


def filter_comment_list(
    comments: list[dict],
    by_user: str | None = None,
    since_date: date | None = None,
    no_bots: bool = False,
) -> list[dict]:
    """Filter a flat list of authored items: issue comments or reviews."""
    filtered = []
    for c in comments:
        if no_bots and c["is_bot"]:
            continue
        if by_user and c["author"].lower() != by_user.lower():
            continue
        if since_date:
            try:
                if parse_datetime(c["created_at"]).date() < since_date:
                    continue
            except (ValueError, TypeError):
                pass
        filtered.append(c)
    return filtered


def drop_empty_reviews(reviews: list[dict]) -> list[dict]:
    """Discard reviews that carry no information.

    Submitting inline notes creates a COMMENTED review with an empty body. That
    review is a container for comments the thread listing already shows. An
    approval or a change request still matters with an empty body; its state is
    the message.
    """
    return [
        r for r in reviews
        if r["body"].strip() or r["state"] != "COMMENTED"
    ]


# ---------------------------------------------------------------------------
# Output: human-readable
# ---------------------------------------------------------------------------

def format_date(iso_str: str) -> str:
    try:
        dt = parse_datetime(iso_str)
        return dt.strftime("%Y-%m-%d")
    except (ValueError, TypeError):
        return iso_str[:10] if len(iso_str) >= 10 else iso_str


STATE_LABELS = {
    "APPROVED": "approved",
    "CHANGES_REQUESTED": "changes requested",
    "COMMENTED": "commented",
    "DISMISSED": "dismissed",
    "PENDING": "pending",
}

DIFF_HUNK_LINES = 6


def render_hunk(hunk: str) -> list[str]:
    """Render the tail of a diff hunk as a fenced block.

    The hunk ends at the line the comment anchors to. The tail is the part that
    gives the comment its context.
    """
    hunk_lines = [ln for ln in hunk.split("\n") if ln]
    if not hunk_lines:
        return []
    tail = hunk_lines[-DIFF_HUNK_LINES:]
    prefix = ["```diff"]
    if len(hunk_lines) > DIFF_HUNK_LINES:
        prefix.append(f"@@ ... {len(hunk_lines) - DIFF_HUNK_LINES} earlier lines omitted")
    return prefix + tail + ["```", ""]


def render_human(
    pr_info: dict,
    threads: list[dict],
    issue_comments: list[dict],
    reviews: list[dict],
    show_diff: bool = False,
) -> str:
    lines = []
    lines.append(f"# PR #{pr_info['number']}: {pr_info['title']} - @{pr_info['author']}")
    lines.append("")

    # Reviews carry the verdict and the summary body. Lead with them.
    if reviews:
        lines.append("## Reviews")
        lines.append("")
        for r in reviews:
            state = STATE_LABELS.get(r["state"], r["state"].lower())
            lines.append(
                f"**@{r['author']}** [{state}] ({format_date(r['created_at'])}):"
            )
            body = r["body"].strip()
            if body:
                for body_line in body.split("\n"):
                    lines.append(f"> {body_line}")
            else:
                lines.append("> (no summary body)")
            lines.append("")

    # Top-level comments
    if issue_comments:
        lines.append("## Top-level comments")
        lines.append("")
        for c in issue_comments:
            lines.append(f"**@{c['author']}** ({format_date(c['created_at'])}):")
            for body_line in c["body"].split("\n"):
                lines.append(f"> {body_line}")
            lines.append("")

    # Group threads by file
    threads_by_file: dict[str, list[dict]] = {}
    for t in threads:
        f = t["file"] or "(no file)"
        threads_by_file.setdefault(f, []).append(t)

    for filepath, file_threads in sorted(threads_by_file.items()):
        lines.append(f"## {filepath}")
        lines.append("")

        for thread in file_threads:
            # Line range
            start = thread.get("start_line")
            end = thread.get("line")
            if start and end and start != end:
                loc = f"L{start}-L{end}"
            elif end:
                loc = f"L{end}"
            else:
                # An outdated thread loses its line once the diff moves past it.
                loc = "(line gone)"

            # Status
            status_parts = []
            if thread["is_resolved"]:
                status_parts.append("resolved")
            else:
                status_parts.append("unresolved")
            if thread["is_outdated"]:
                status_parts.append("outdated")
            status = ", ".join(status_parts)

            lines.append(f"### {loc} [{status}]")
            lines.append("")

            if show_diff and thread.get("diff_hunk"):
                lines.extend(render_hunk(thread["diff_hunk"]))

            for i, c in enumerate(thread["comments"]):
                prefix = "  " if i > 0 else ""
                lines.append(f"{prefix}**@{c['author']}** ({format_date(c['created_at'])}):")
                for body_line in c["body"].split("\n"):
                    lines.append(f"{prefix}> {body_line}")
                lines.append("")

        lines.append("---")
        lines.append("")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Output: JSON
# ---------------------------------------------------------------------------

def render_json(
    pr_info: dict,
    threads: list[dict],
    issue_comments: list[dict],
    reviews: list[dict],
) -> str:
    return json.dumps({
        "pr": pr_info,
        "reviews": reviews,
        "issue_comments": issue_comments,
        "review_threads": threads,
    }, indent=2, default=str)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Fetch and display all review activity on a GitHub PR.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  pr-comments https://github.com/owner/repo/pull/123
  pr-comments 123 --repo owner/repo
  pr-comments https://github.com/owner/repo/pull/123 --unresolved
  pr-comments https://github.com/owner/repo/pull/123 --by reviewer-name
  pr-comments https://github.com/owner/repo/pull/123 --since 2026-04-01
  pr-comments https://github.com/owner/repo/pull/123 --no-bots --unresolved
  pr-comments https://github.com/owner/repo/pull/123 --path src/api --diff
""",
    )
    parser.add_argument("pr", help="PR URL or number")
    parser.add_argument("--repo", help="owner/repo (required when using PR number)")
    parser.add_argument("--unresolved", action="store_true",
                        help="Show only unresolved threads")
    parser.add_argument("--by", metavar="USERNAME",
                        help="Filter to comments by a specific user")
    parser.add_argument("--since", metavar="DATE",
                        help="Only show comments after date (YYYY-MM-DD)")
    parser.add_argument("--path", metavar="PATTERN", action="append",
                        help="Only show threads on matching paths. Repeatable. "
                             "A plain value matches as a directory prefix; "
                             "a value with * ? [ matches as a glob.")
    parser.add_argument("--no-bots", action="store_true",
                        help="Hide reviews and comments authored by bots")
    parser.add_argument("--diff", action="store_true",
                        help="Show the diff hunk each thread anchors to")
    parser.add_argument("--json", action="store_true",
                        help="Output as JSON")

    args = parser.parse_args()

    owner, repo, number = parse_pr_ref(args.pr, args.repo)
    since_date = date.fromisoformat(args.since) if args.since else None

    print(f"Fetching PR #{number} from {owner}/{repo}...", file=sys.stderr)

    pr_info, threads = fetch_review_threads(owner, repo, number)
    issue_comments = fetch_issue_comments(owner, repo, number)
    reviews = fetch_reviews(owner, repo, number)

    # Apply filters
    threads = filter_threads(threads, args.unresolved, args.by, since_date,
                             args.no_bots, args.path)
    issue_comments = filter_comment_list(issue_comments, args.by, since_date,
                                         args.no_bots)
    reviews = filter_comment_list(drop_empty_reviews(reviews), args.by,
                                  since_date, args.no_bots)

    unresolved = sum(1 for t in threads if not t["is_resolved"])
    print(f"Found {len(reviews)} reviews, "
          f"{len(threads)} review threads ({unresolved} unresolved), "
          f"{len(issue_comments)} top-level comments.", file=sys.stderr)

    if args.json:
        print(render_json(pr_info, threads, issue_comments, reviews))
    else:
        print(render_human(pr_info, threads, issue_comments, reviews, args.diff))


if __name__ == "__main__":
    main()
