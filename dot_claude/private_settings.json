{
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(mvnd *)",
      "Bash(./mvnw *)",
      "Bash(man *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(git show *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * show *)",
      "Bash(git -C * status *)",
      "Bash(git -C * ls-tree *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(gh search *)",
      "Bash(jar tf *)",
      "Bash(unzip -p *)",
      "Bash(unzip -l *)",
      "Bash(just --list)",
      "Bash(just --dry-run *)",
      "mcp__claude_ai_Atlassian__atlassianUserInfo",
      "mcp__claude_ai_Atlassian__fetch",
      "mcp__claude_ai_Atlassian__get*",
      "mcp__claude_ai_Atlassian__lookup*",
      "mcp__claude_ai_Atlassian__search*",
      "mcp__claude_ai_Glean__*",
      "mcp__claude_ai_Gmail__get*",
      "mcp__claude_ai_Gmail__list*",
      "mcp__claude_ai_Gmail__search*",
      "mcp__claude_ai_Google_Calendar__get*",
      "mcp__claude_ai_Google_Calendar__list*",
      "mcp__claude_ai_Google_Calendar__suggest*",
      "mcp__claude_ai_Slack__*"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-main-repo-in-worktree.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "session-report@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "advisorModel": "opus",
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.89",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "theme": "light",
  "skipAutoPermissionPrompt": true
}
