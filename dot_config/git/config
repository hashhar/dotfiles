[includeIf "gitdir:~/code/src/github.com/hashhar/"]
    path = identity-personal
[includeIf "gitdir:~/code/src/github.com/trinodb/"]
    path = identity-starburst
[includeIf "gitdir:~/code/src/github.com/starburstdata/"]
    path = identity-starburst
[user]
	name = Ashhar Hasan
	# Require setting user.name and email per-repo
	useConfigOnly = true
	signingkey = 4CD0188E0E5784EF
[core]
	safecrlf = warn
	autocrlf = input
	editor = nvim
	pager = delta
	# Speeds up status/diff in large repos. Revert these two first if status misbehaves.
	fsmonitor = true
	untrackedCache = true
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
[interactive]
	diffFilter = delta --color-only
[commit]
	template = ~/.config/git/commit-template
	verbose = true
	# Enable this on a per-repo basis using `git config commit.gpgsign true`
	#gpgsign = true
[diff]
	renames = copies
	submodule = log
	algorithm = histogram
	wsErrorHighlight = old,new,context
	tool = vscode
	# Distinguish moved code from added/removed code when reviewing refactors.
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[difftool]
	prompt = false
# Opt-in structural diff: `git difftool -t difftastic <rev>`. Never set as
# diff.external - that output cannot be applied as a patch and breaks `add -p`.
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[fetch]
	recurseSubmodules = on-demand
	prune = true
[pull]
	ff = only
[format]
	attach = true
	from = true
	coverLetter = auto
[grep]
	lineNumber = true
[mailinfo]
	scissors = true
[merge]
	branchdesc = true
	log = true
	tool = vscode
	renameLimit = 0
	# Show the merge base alongside both sides in conflict markers.
	conflictStyle = zdiff3
[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[rerere]
	# Record conflict resolutions and replay them. Pays for itself when a stacked
	# branch is rebased more than once. Replayed resolutions are left unstaged
	# deliberately, so a wrong one recorded earlier cannot slip through unreviewed.
	enabled = true
[pack]
	threads = 0
[push]
	default = simple
	recurseSubmodules = check
	# No more `--set-upstream` on the first push of a branch.
	autoSetupRemote = true
[rebase]
	missingCommitsCheck = warn
	autoStash = true
	# Move every branch ref in a stack, not just the one being rebased.
	updateRefs = true
[status]
	submoduleSummary = true
[alias]
	grog = log --graph --abbrev-commit --decorate --all --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)\"
	s = status -s

	# Show the diff between the latest commit and the current state
	d = !"git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"

	# Remove the old tag with this name and tag the latest commit with it.
	retag = "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"
[gpg]
	program = gpg
[log]
	follow = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[init]
	defaultBranch = main
